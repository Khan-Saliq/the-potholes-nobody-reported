# CivicPulse - Environment Variables for Deployment

# Copy this file to .env and fill in your values

# MongoDB Atlas Connection (get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/civicpulse?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=production

# API URLs (update after deployment)
API_BASE_URL=https://your-backend.onrender.com
VITE_API_URL=https://your-backend.onrender.com/api

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database Seeding (set to true for first deployment)
SEED_DATABASE=true

# Hive API (your provided key)
HIVE_API_KEY=HpEjbawaZ8bmeJn2
HIVE_SECRET_KEY=IUDglfRhLje/u/kAr4EyMg==

# Python AI Service URL (update after Python service deployment)
PYTHON_AI_SERVICE_URL=https://your-python-service.onrender.com

# OpenAI (optional - for chatbot)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Gemini API Key for Vision Analysis
GEMINI_API_KEY=your-gemini-api-key-here
